@@ -0,0 +1,272 @@
+name: Release
+on:
+  push:
+    tags: ['v*']
+  workflow_dispatch:
+    inputs:
+      tag:
+        description: Existing version tag; leave blank only for a TestPyPI rehearsal of the selected ref
+        required: false
+        type: string
+      target:
+        description: TestPyPI only, or all configured production destinations
+        required: true
+        type: choice
+        default: testpypi
+        options: [testpypi, production]
+# One release at a time: do not cancel a partly-published distribution.
+concurrency:
+  group: rastermoves-release
+  cancel-in-progress: false
+permissions:
+  contents: read
+jobs:
+  prepare:
+    if: github.repository == 'kieransimkin/RasterMoves'
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    outputs:
+      tag: ${{ steps.metadata.outputs.tag }}
+      version: ${{ steps.metadata.outputs.version }}
+      commit: ${{ steps.metadata.outputs.commit }}
+      image: ${{ steps.metadata.outputs.image }}
+      prerelease: ${{ steps.metadata.outputs.prerelease }}
+      target: ${{ steps.route.outputs.target }}
+    steps:
+      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
+        with:
+          ref: ${{ inputs.tag && format('refs/tags/{0}', inputs.tag) || github.ref }}
+          fetch-depth: 0
+          persist-credentials: false
+      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6
+        with:
+          python-version: '3.12'
+      - name: Validate tag, source versions and exact commit
+        id: metadata
+        env:
+          RELEASE_TAG: ${{ github.event_name == 'push' && github.ref_name || inputs.tag }}
+          TARGET: ${{ inputs.target || 'production' }}
+        shell: bash
+        run: |
+          extra=()
+          if [ "$TARGET" = testpypi ] && [ -z "$RELEASE_TAG" ]; then extra+=(--allow-untagged); fi
+          python scripts/release_tools.py metadata --tag "$RELEASE_TAG" --repository "$GITHUB_REPOSITORY" \
+            --github-output "$GITHUB_OUTPUT" "${extra[@]}"
+      - id: route
+        env:
+          TARGET: ${{ inputs.target || 'production' }}
+        run: echo "target=$TARGET" >> "$GITHUB_OUTPUT"
+  checks:
+    needs: prepare
+    uses: ./.github/workflows/tests.yml
+    with:
+      ref: ${{ needs.prepare.outputs.commit }}
+  pypi:
+    needs: [prepare, checks]
+    if: needs.prepare.outputs.target == 'production'
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    environment:
+      name: pypi
+      url: https://pypi.org/project/rastermoves/
+    permissions:
+      id-token: write
+    steps:
+      - uses: actions/download-artifact@634f93cb2916e3fdff6788551b99b062d0335ce0 # v5
+        with:
+          name: python-dist
+          path: dist/
+      - name: Publish wheel and source distribution using Trusted Publishing
+        uses: pypa/gh-action-pypi-publish@dc37677b2e1c63e2034f94d8a5b11f265b73ba33 # release/v1
+        with:
+          packages-dir: dist/
+          attestations: true
+          # Do not conceal a duplicate version or changed release by skipping it.
+          skip-existing: false
+  testpypi:
+    needs: [prepare, checks]
+    if: needs.prepare.outputs.target == 'testpypi' || vars.PUBLISH_TESTPYPI == 'true'
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    environment:
+      name: testpypi
+      url: https://test.pypi.org/project/rastermoves/
+    permissions:
+      id-token: write
+    steps:
+      - uses: actions/download-artifact@634f93cb2916e3fdff6788551b99b062d0335ce0 # v5
+        with:
+          name: python-dist
+          path: dist/
+      - uses: pypa/gh-action-pypi-publish@dc37677b2e1c63e2034f94d8a5b11f265b73ba33 # release/v1
+        with:
+          packages-dir: dist/
+          repository-url: https://test.pypi.org/legacy/
+          attestations: true
+          skip-existing: false
+  github-release:
+    needs: [prepare, checks]
+    if: needs.prepare.outputs.target == 'production'
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: write
+    env:
+      GH_TOKEN: ${{ github.token }}
+      GH_REPO: ${{ github.repository }}
+      TAG: ${{ needs.prepare.outputs.tag }}
+      VERSION: ${{ needs.prepare.outputs.version }}
+      PRERELEASE: ${{ needs.prepare.outputs.prerelease }}
+    steps:
+      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
+        with:
+          ref: ${{ needs.prepare.outputs.commit }}
+          persist-credentials: false
+      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6
+        with:
+          python-version: '3.12'
+      - uses: actions/download-artifact@634f93cb2916e3fdff6788551b99b062d0335ce0 # v5
+        with:
+          name: python-dist
+          path: dist/
+      - run: python scripts/release_tools.py dist --checksums dist/SHA256SUMS
+      - name: Attach artifacts while draft, then publish the release
+        shell: bash
+        run: |
+          # Never replace assets on an already published/immutable release.
+          if DRAFT=$(gh release view "$TAG" --json isDraft --jq .isDraft); then
+            if [ "$DRAFT" != true ]; then
+              mkdir -p "$RUNNER_TEMP/existing-release"
+              gh release download "$TAG" -D "$RUNNER_TEMP/existing-release" \
+                -p '*.whl' -p '*.tar.gz' -p 'SHA256SUMS'
+              for file in dist/*.whl dist/*.tar.gz dist/SHA256SUMS; do
+                cmp "$file" "$RUNNER_TEMP/existing-release/$(basename "$file")"
+              done
+              echo 'Published release already has the identical artifacts.'
+              exit 0
+            fi
+          else
+            gh release create "$TAG" --verify-tag --draft --title "RasterMoves $VERSION" --generate-notes
+          fi
+          gh release upload "$TAG" dist/*.whl dist/*.tar.gz dist/SHA256SUMS --clobber
+          gh release edit "$TAG" --draft=false --prerelease="$PRERELEASE"
+  ghcr:
+    needs: [prepare, checks]
+    if: needs.prepare.outputs.target == 'production'
+    runs-on: ubuntu-latest
+    timeout-minutes: 40
+    permissions:
+      contents: read
+      packages: write
+    outputs:
+      digest: ${{ steps.publish.outputs.digest }}
+    env:
+      IMAGE: ${{ needs.prepare.outputs.image }}
+      VERSION: ${{ needs.prepare.outputs.version }}
+      PRERELEASE: ${{ needs.prepare.outputs.prerelease }}
+    steps:
+      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
+        with:
+          ref: ${{ needs.prepare.outputs.commit }}
+          persist-credentials: false
+      - uses: actions/download-artifact@634f93cb2916e3fdff6788551b99b062d0335ce0 # v5
+        with:
+          name: python-dist
+          path: dist/
+      - uses: docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f # v3
+      - name: Build CPU container from the tested wheel (not from PyPI)
+        uses: docker/build-push-action@10e90e3645eae34f1e60eeb005ba3a3d33f178e8 # v6
+        with:
+          context: .
+          platforms: linux/amd64
+          load: true
+          push: false
+          tags: rastermoves:release-check
+          build-args: |
+            VERSION=${{ needs.prepare.outputs.version }}
+            REVISION=${{ needs.prepare.outputs.commit }}
+            SOURCE_URL=https://github.com/${{ github.repository }}
+          cache-from: type=gha,scope=rastermoves-cpu
+          cache-to: type=gha,mode=max,scope=rastermoves-cpu
+      - name: Smoke-test the image before pushing it
+        shell: bash
+        run: |
+          docker run --rm --network none rastermoves:release-check --version
+          docker run --rm --network none --entrypoint python \
+            -v "$PWD/scripts/smoke_installed.py:/tmp/smoke_installed.py:ro" \
+            rastermoves:release-check /tmp/smoke_installed.py --version "$VERSION" --runtimes
+      - uses: docker/login-action@c94ce9fb468520275223c153574b00df6fe4bcc9 # v3
+        with:
+          registry: ghcr.io
+          username: ${{ github.actor }}
+          password: ${{ github.token }}
+      - name: Push the exact smoke-tested image
+        id: publish
+        shell: bash
+        run: |
+          tags=("$VERSION" "$VERSION-cpu")
+          if [ "$PRERELEASE" = false ]; then tags+=(latest cpu); fi
+          for tag in "${tags[@]}"; do
+            docker tag rastermoves:release-check "$IMAGE:$tag"
+            docker push "$IMAGE:$tag"
+          done
+          REPO_DIGEST=$(docker inspect --format '{{index .RepoDigests 0}}' "$IMAGE:$VERSION")
+          DIGEST=${REPO_DIGEST##*@}
+          [[ "$DIGEST" =~ ^sha256:[a-f0-9]{64}$ ]]
+          echo "digest=$DIGEST" >> "$GITHUB_OUTPUT"
+          echo "Published $IMAGE@$DIGEST" >> "$GITHUB_STEP_SUMMARY"
+  dockerhub:
+    needs: [prepare, ghcr]
+    if: needs.prepare.outputs.target == 'production' && vars.DOCKERHUB_USERNAME != ''
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    permissions:
+      packages: read
+    env:
+      VERSION: ${{ needs.prepare.outputs.version }}
+      PRERELEASE: ${{ needs.prepare.outputs.prerelease }}
+      SOURCE_IMAGE: ${{ needs.prepare.outputs.image }}@${{ needs.ghcr.outputs.digest }}
+      HUB_REPOSITORY: ${{ vars.DOCKERHUB_REPOSITORY || format('{0}/rastermoves', vars.DOCKERHUB_USERNAME) }}
+    steps:
+      - name: Check Docker Hub credentials and lowercase repository name
+        env:
+          HUB_TOKEN: ${{ secrets.DOCKERHUB_TOKEN }}
+        shell: bash
+        run: |
+          test -n "$HUB_TOKEN" || { echo 'Set DOCKERHUB_TOKEN or remove DOCKERHUB_USERNAME to disable the mirror.'; exit 1; }
+          [[ "$HUB_REPOSITORY" =~ ^[a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9_.-]*$ ]]
+      - uses: docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f # v3
+      - uses: docker/login-action@c94ce9fb468520275223c153574b00df6fe4bcc9 # v3
+        with:
+          registry: ghcr.io
+          username: ${{ github.actor }}
+          password: ${{ github.token }}
+      - uses: docker/login-action@c94ce9fb468520275223c153574b00df6fe4bcc9 # v3
+        with:
+          username: ${{ vars.DOCKERHUB_USERNAME }}
+          password: ${{ secrets.DOCKERHUB_TOKEN }}
+      - name: Mirror the GHCR digest without rebuilding
+        shell: bash
+        run: |
+          tags=(-t "docker.io/$HUB_REPOSITORY:$VERSION" -t "docker.io/$HUB_REPOSITORY:$VERSION-cpu")
+          if [ "$PRERELEASE" = false ]; then tags+=(-t "docker.io/$HUB_REPOSITORY:latest" -t "docker.io/$HUB_REPOSITORY:cpu"); fi
+          docker buildx imagetools create "${tags[@]}" "$SOURCE_IMAGE"
+  summary:
+    if: always()
+    needs: [prepare, checks, pypi, testpypi, github-release, ghcr, dockerhub]
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions: {}
+    steps:
+      - name: Show each destination's actual result
+        env:
+          JOBS: ${{ toJSON(needs) }}
+        run: |
+          python - <<'PY'
+          import json, os
+          with open(os.environ['GITHUB_STEP_SUMMARY'], 'a') as f:
+              f.write('## RasterMoves release results\n\n| Job | Result |\n|---|---|\n')
+              for name, info in json.loads(os.environ['JOBS']).items():
+                  f.write(f"| {name} | {info['result']} |\n")
+              f.write('\nSkipped optional destinations are not published. Re-run failed jobs after fixing configuration.\n')
+          PY
