+    data = read_trace(tmp_path / "failed.png.trace.json")
+    assert data["rastermoves"]["status"] == "failed" and data["rastermoves"]["exit_code"] == 1
+    assert slices(data, "model")[0]["args"]["error_type"] == "UpscaleError"
