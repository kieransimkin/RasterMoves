+def test_single_model_failure_still_has_trace_and_exit_code(tmp_path, image_args, monkeypatch):
+    def fail(*args, **kwargs):
+        raise UpscaleError("synthetic load failure")
+    monkeypatch.setattr(ModelPlugin, "load", fail)
